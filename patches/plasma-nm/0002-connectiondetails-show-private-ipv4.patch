From c6548f06f47a8e884b63a40b20be27bea6864579 Mon Sep 17 00:00:00 2001
From: v <v@v>
Date: Sat, 8 Aug 2026 18:54:29 -0300
Subject: [PATCH 2/2] editor: show private (RFC1918) IPv4 addresses in
 connection details

---
 libs/editor/connectiondetails.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/libs/editor/connectiondetails.cpp b/libs/editor/connectiondetails.cpp
index 1a791f1..2a87f0e 100644
--- a/libs/editor/connectiondetails.cpp
+++ b/libs/editor/connectiondetails.cpp
@@ -321,7 +321,11 @@ getConnectionDetails(const NetworkManager::Connection::Ptr &connection, const Ne
         QList<QPair<QString, QString>> details;
         if (!device->ipV4Config().addresses().isEmpty()) {
             QHostAddress addr = device->ipV4Config().addresses().first().ip();
-            if (!addr.isNull() && addr.isGlobal()) {
+            // VPN tunnel addresses are frequently private (RFC1918), for which
+            // QHostAddress::isGlobal() is false — the row was silently hidden.
+            // The gateway/DNS rows below have no such filter, so show any
+            // assigned address, skipping only unusable special ones.
+            if (!addr.isNull() && !addr.isLoopback() && !addr.isLinkLocal() && !addr.isMulticast() && !addr.isBroadcast()) {
                 details.append({i18n("IPv4 Address"), addr.toString()});
             }
         }
